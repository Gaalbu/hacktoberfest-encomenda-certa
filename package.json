{
  "name": "encomenda-certa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=12 <13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --watch server/index.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "test:api": "vitest run server/app.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "check": "npm run test && npm run typecheck && npm run build",
    "quality": "aislop scan --json"
  },
  "dependencies": {
    "@mastra/core": "1.76.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "aislop": "0.18.1",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
